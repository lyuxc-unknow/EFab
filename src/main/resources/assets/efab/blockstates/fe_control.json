{
  "multipart": [
    {
      "when": { "facing": "south" },
      "apply": { "model": "efab:block/fe_control" }
    },
    {
      "when": { "facing": "north" },
      "apply": { "model": "efab:block/fe_control", "y": 180 }
    },
    {
      "when": { "facing": "east" },
      "apply": { "model": "efab:block/fe_control", "y": 270 }
    },
    {
      "when": { "facing": "west" },
      "apply": { "model": "efab:block/fe_control", "y": 90 }
    },
    {
      "when": { "facing": "south", "sparks": "true" },
      "apply": { "model": "efab:block/sparks" }
    },
    {
      "when": { "facing": "north", "sparks": "true" },
      "apply": { "model": "efab:block/sparks", "y": 180 }
    },
    {
      "when": { "facing": "east", "sparks": "true" },
      "apply": { "model": "efab:block/sparks", "y": 270 }
    },
    {
      "when": { "facing": "west", "sparks": "true" },
      "apply": { "model": "efab:block/sparks", "y": 90 }
    }
  ]
}
